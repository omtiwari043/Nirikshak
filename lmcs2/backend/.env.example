# Copy to backend/.env for local (non-Docker) development.
# pydantic-settings loads this automatically (see app/config.py).

ENV=development
SECRET_KEY=dev-only-secret-change-me
DATABASE_URL=sqlite:///./lmcs.db

OCR_LANG=en
OCR_USE_GPU=false
OCR_WARM_UP_ON_STARTUP=true

CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
