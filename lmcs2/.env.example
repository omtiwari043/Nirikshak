# Copy this file to .env and fill in real values before deploying.
# Used by docker-compose.yml (root-level values) and by backend/app/config.py
# when running the backend outside Docker (copy backend/.env.example too, or
# just export these same variables / drop a .env inside backend/).

# --- Security (REQUIRED — do not ship the defaults) ---
SECRET_KEY=change_me_generate_with__python -c "import secrets; print(secrets.token_urlsafe(64))"
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --- Database (docker-compose wires this automatically; only needed standalone) ---
DATABASE_URL=postgresql://lmcs_user:change_me_to_a_strong_password@db:5432/lmcs

# --- OCR (PaddleOCR) ---
OCR_LANG=en
OCR_USE_GPU=false
OCR_WARM_UP_ON_STARTUP=true

# --- CORS ---
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:5173"]

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=15
